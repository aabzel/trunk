    include $(USB_DEVICE_LIB_DIR)/Class/Class.mk

    INCDIR += -I$(USB_DEVICE_LIB_DIR)/Core/inc

    SOURCES_THIRD_PARTY_C += $(USB_DEVICE_LIB_DIR)/Core/Src/usbd_core.c
