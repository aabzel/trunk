# stm32f4xx_hal_driver.cmake
if(NOT (STM32F4XX_HAL_DRIVER_MK_INC STREQUAL Y))
    set(STM32F4XX_HAL_DRIVER_MK_INC Y)

    set(STM32F4X_HAL_DRIVER_DIR "${VENDOR_SDK_DIR}/STM32F4xx_HAL_Driver")

    include_directories( ${STM32F4X_HAL_DRIVER_DIR})

    set(STM32F4XX_HAL_DRIVER Y)

    string(APPEND MCAL_OPT " -DHAS_STM32F4XX_HAL_DRIVER")
    string(APPEND MCAL_OPT " -DUSE_HAL_DRIVER")
    string(APPEND MCAL_OPT " -DHAL_CORTEX_MODULE_ENABLED")
    string(APPEND MCAL_OPT " -DHAL_PWR_MODULE_ENABLED")
    string(APPEND MCAL_OPT " -DHAL_MODULE_ENABLED")
    string(APPEND MCAL_OPT " -DHAL_NOR_MODULE_ENABLED")

    if(EXTI STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_EXTI_MODULE_ENABLED")
    endif()

    set(RCC Y)
    string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal.c")
    string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_cortex.c")

    if(ADC STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_ADC_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_adc.c")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_adc_ex.c")
    endif()

    if(CAN STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_CAN_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/Src/stm32f4xx_hal_can.c")
    endif()

    if(RCC STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_RCC_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_rcc.c")
        if(HAL_RCC_EX STREQUAL Y)
            string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_rcc_ex.c")
        endif()
    endif()

    if(IWDG STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_IWDG_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_iwdg.c")
    endif()

    if(CRYP STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_CRYP_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_cryp.c")
    endif()

    if(GPIO STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_GPIO_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_gpio.c")
    endif()

    if(HAL_DMA STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_DMA_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_dma.c")
    endif()

    if(I2S STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_I2S_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_i2s.c")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_i2s_ex.c")
    endif()

    if(I2C STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_I2C_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_i2c.c")
    endif()

    if(SPI STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_SPI_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_spi.c")
    endif()

    if(SDIO STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_SD_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_sd.c")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_ll_sdmmc.c")
    endif()

    set(HAL_FLASH Y)
    if(HAL_FLASH STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_FLASH_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_flash.c")
        if(HAL_FLASH_EX STREQUAL Y)
            string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_flash_ex.c")
        endif()
    endif()

    if(RTC STREQUAL Y)
        string(APPEND MCAL_OPT " -DHAL_RTC_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_rtc.c")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_rcc_ex.c")
    endif()

    if(UART STREQUAL Y)
        set(HAL_DMA Y)
        string(APPEND MCAL_OPT " -DHAL_UART_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_uart.c")
    endif()

    if(HAL_USB STREQUAL Y)
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_ll_usb.c")
        if(USB_DEVICE STREQUAL Y)
            string(APPEND MCAL_OPT " -DHAL_PCD_MODULE_ENABLED")
            string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_pcd.c")
            string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_pcd_ex.c")
        endif()

        if(USB_HOST STREQUAL Y)
            string(APPEND MCAL_OPT " -DHAL_HCD_MODULE_ENABLED")
            string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_hcd.c")
        endif()
    endif()

    if(TIMER STREQUAL Y)
        if(HAL_TIM_PWM STREQUAL Y)
            string(APPEND MCAL_OPT " -DHAS_HAL_TIM_PWM")
            string(APPEND MCAL_OPT " -DHAS_HAL_TIM_OC")
        endif()
        string(APPEND MCAL_OPT " -DHAL_TIM_MODULE_ENABLED")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_tim.c")
        string(APPEND SOURCES_THIRD_PARTY_C " ${STM32F4X_HAL_DRIVER_DIR}/stm32f4xx_hal_tim_ex.c")
    endif()
endif()
